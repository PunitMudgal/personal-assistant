{
  "name": "personal-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint",
    "db:generate": "cross-env NODE_ENV=development drizzle-kit generate",
    "db:migrate": "cross-env NODE_ENV=development drizzle-kit migrate",
    "db:migrate:prod": "cross-env NODE_ENV=production drizzle-kit migrate",
    "db:push": "cross-env NODE_ENV=development drizzle-kit push",
    "db:studio": "cross-env NODE_ENV=development drizzle-kit studio",
    "db:enable-pgvector": "cross-env NODE_ENV=development node --env-file=.env.development --import tsx scripts/enable-pgvector.ts",
    "db:enable-pgvector:prod": "cross-env NODE_ENV=production node --env-file=.env.production --import tsx scripts/enable-pgvector.ts",
    "db:apply-email-embeddings": "cross-env NODE_ENV=development node --env-file=.env.development --import tsx scripts/apply-email-embeddings.ts",
    "db:apply-email-embeddings:prod": "cross-env NODE_ENV=production node --env-file=.env.production --import tsx scripts/apply-email-embeddings.ts",
    "db:seed:emails": "cross-env NODE_ENV=development node --env-file=.env.development --import tsx scripts/seed-emails.ts",
    "db:seed:emails:prod": "cross-env NODE_ENV=production node --env-file=.env.production --import tsx scripts/seed-emails.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.11",
    "@ai-sdk/groq": "^4.0.7",
    "@ai-sdk/react": "^4.0.15",
    "@auth/drizzle-adapter": "^1.11.2",
    "@neondatabase/serverless": "^1.1.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "ai": "^7.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.23.0",
    "marked": "^18.0.6",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "okapibm25": "^1.4.1",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.13.0",
    "shiki": "^4.3.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3"
  }
}
