# Copy for each mode:
#   cp .env.example .env.development
#   cp .env.example .env.production
#
# Scripts set NODE_ENV, then the app loads `.env.${NODE_ENV}`:
#   pnpm dev                         → NODE_ENV=development → .env.development
#   pnpm build / pnpm start / bun start → NODE_ENV=production  → .env.production
#   pnpm db:migrate:prod             → NODE_ENV=production  → .env.production

# Database
DATABASE_URL=

# AI providers
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROTUER_API_KEY=

# Auth.js (NextAuth v5)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Development: http://localhost:3000
# Production:  https://your-domain.com
AUTH_URL=

# Google OAuth
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
